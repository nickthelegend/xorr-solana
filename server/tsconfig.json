{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  // `scripts/` too: the autonomous-agent demo drives the real executor path and calls the same
  // functions the scheduler does, so a signature change that breaks it should break the build
  // rather than the demo.
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
